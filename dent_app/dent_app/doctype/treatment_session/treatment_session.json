{
    "name": "Treatment Session",
    "module": "Dent App",
    "doctype": "DocType",
    "autoname": "format:SES-{YYYY}-{#####}",
    "title_field": "treatment_plan",
    "search_fields": "patient,treatment_plan",
    "track_changes": 1,
    "sort_field": "session_date",
    "sort_order": "DESC",
    "fields": [
        {"fieldtype": "Section Break", "fieldname": "section_main", "label": "Session Details"},
        {"fieldname": "patient", "label": "Patient", "fieldtype": "Link", "options": "Patient", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "treatment_plan", "label": "Treatment Plan", "fieldtype": "Link", "options": "Treatment Plan", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_1"},
        {"fieldname": "doctor", "label": "Doctor", "fieldtype": "Link", "options": "Doctor", "in_list_view": 1},
        {"fieldname": "status", "label": "Status", "fieldtype": "Select", "options": "Planned\nIn Progress\nCompleted", "default": "Planned", "in_list_view": 1, "in_standard_filter": 1},
        {"fieldtype": "Section Break", "fieldname": "section_datetime", "label": "Date"},
        {"fieldname": "session_date", "label": "Session Date", "fieldtype": "Date", "reqd": 1, "in_list_view": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_2"},
        {"fieldname": "session_time", "label": "Session Time", "fieldtype": "Time"},
        {"fieldtype": "Section Break", "fieldname": "section_notes", "label": "Notes"},
        {"fieldname": "notes", "label": "Notes", "fieldtype": "Text Editor"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1},
        {"role": "Clinic Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1},
        {"role": "Clinic Doctor", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 0},
        {"role": "Clinic Receptionist", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 0}
    ]
}