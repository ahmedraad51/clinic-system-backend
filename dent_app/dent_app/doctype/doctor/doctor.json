{
    "name": "Doctor",
    "module": "Dent App",
    "doctype": "DocType",
    "autoname": "format:DOC-{#####}",
    "title_field": "full_name",
    "search_fields": "full_name,phone_number,email",
    "track_changes": 1,
    "fields": [
        {"fieldtype": "Section Break", "fieldname": "section_basic", "label": "Basic Information"},
        {"fieldname": "full_name", "label": "Full Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_1"},
        {"fieldname": "specialization", "label": "Specialization", "fieldtype": "Select", "options": "General Dentist\nOrthodontist\nEndodontist\nPeriodontist\nOral Surgeon\nPediatric Dentist\nProsthodontist", "reqd": 1, "in_list_view": 1},
        {"fieldtype": "Section Break", "fieldname": "section_contact", "label": "Contact Information"},
        {"fieldname": "phone_number", "label": "Phone Number", "fieldtype": "Data", "options": "Phone", "reqd": 1, "in_list_view": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_2"},
        {"fieldname": "email", "label": "Email", "fieldtype": "Data", "options": "Email"},
        {"fieldtype": "Section Break", "fieldname": "section_schedule", "label": "Working Hours"},
        {"fieldname": "working_days", "label": "Working Days", "fieldtype": "Small Text", "description": "Comma separated, e.g. Monday,Tuesday,Wednesday"},
        {"fieldtype": "Column Break", "fieldname": "col_break_3"},
        {"fieldname": "start_time", "label": "Start Time", "fieldtype": "Time"},
        {"fieldname": "end_time", "label": "End Time", "fieldtype": "Time"},
        {"fieldtype": "Section Break", "fieldname": "section_status", "label": "Status"},
        {"fieldname": "is_active", "label": "Is Active", "fieldtype": "Check", "default": "1", "in_list_view": 1}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1},
        {"role": "Clinic Manager", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 1},
        {"role": "Clinic Receptionist", "read": 1, "write": 0, "create": 0, "delete": 0, "print": 1, "export": 0}
    ]
}