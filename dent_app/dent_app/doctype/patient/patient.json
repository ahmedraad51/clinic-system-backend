{
    "name": "Patient",
    "module": "Dent App",
    "doctype": "DocType",
    "autoname": "format:PAT-{YYYY}-{#####}",
    "title_field": "full_name",
    "search_fields": "full_name,phone_number,email",
    "track_changes": 1,
    "fields": [
        {"fieldtype": "Section Break", "fieldname": "section_basic", "label": "Basic Information"},
        {"fieldname": "full_name", "label": "Full Name", "fieldtype": "Data", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_1"},
        {"fieldname": "patient_id", "label": "Patient ID", "fieldtype": "Data", "read_only": 1},
        {"fieldtype": "Section Break", "fieldname": "section_personal", "label": "Personal Details"},
        {"fieldname": "gender", "label": "Gender", "fieldtype": "Select", "options": "Male\nFemale\nOther", "in_list_view": 1},
        {"fieldname": "date_of_birth", "label": "Date of Birth", "fieldtype": "Date"},
        {"fieldname": "age", "label": "Age", "fieldtype": "Int", "read_only": 1},
        {"fieldtype": "Column Break", "fieldname": "col_break_2"},
        {"fieldname": "phone_number", "label": "Phone Number", "fieldtype": "Data", "options": "Phone", "reqd": 1, "in_list_view": 1, "in_standard_filter": 1},
        {"fieldname": "secondary_phone", "label": "Secondary Phone", "fieldtype": "Data", "options": "Phone"},
        {"fieldname": "email", "label": "Email", "fieldtype": "Data", "options": "Email"},
        {"fieldname": "address", "label": "Address", "fieldtype": "Small Text"},
        {"fieldtype": "Section Break", "fieldname": "section_medical", "label": "Medical Information"},
        {"fieldname": "medical_history", "label": "Medical History", "fieldtype": "Text Editor"},
        {"fieldtype": "Column Break", "fieldname": "col_break_3"},
        {"fieldname": "allergies", "label": "Allergies", "fieldtype": "Small Text"},
        {"fieldname": "current_medications", "label": "Current Medications", "fieldtype": "Small Text"},
        {"fieldname": "chronic_diseases", "label": "Chronic Diseases", "fieldtype": "Small Text"},
        {"fieldname": "notes", "label": "Notes", "fieldtype": "Text Editor"},
        {"fieldtype": "Section Break", "fieldname": "section_stats", "label": "Statistics"},
        {"fieldname": "total_appointments", "label": "Total Appointments", "fieldtype": "Int", "read_only": 1, "default": "0"},
        {"fieldtype": "Column Break", "fieldname": "col_break_4"},
        {"fieldname": "total_treatments", "label": "Total Treatments", "fieldtype": "Int", "read_only": 1, "default": "0"},
        {"fieldtype": "Column Break", "fieldname": "col_break_5"},
        {"fieldname": "total_paid", "label": "Total Paid", "fieldtype": "Currency", "read_only": 1, "default": "0"},
        {"fieldtype": "Column Break", "fieldname": "col_break_6"},
        {"fieldname": "total_remaining", "label": "Total Remaining Balance", "fieldtype": "Currency", "read_only": 1, "default": "0"}
    ],
    "permissions": [
        {"role": "System Manager", "read": 1, "write": 1, "create": 1, "delete": 1, "print": 1, "export": 1},
        {"role": "Clinic Manager", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 1},
        {"role": "Clinic Doctor", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 0},
        {"role": "Clinic Receptionist", "read": 1, "write": 1, "create": 1, "delete": 0, "print": 1, "export": 0}
    ]
}